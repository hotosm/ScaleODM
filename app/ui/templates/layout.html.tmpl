{{ define "layout.start" }}
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{ .Title }}</title>
    <link rel="icon" type="image/svg+xml" href="/ui/static/favicon.svg" />
    <link rel="stylesheet" href="/ui/static/ui.css" />
  </head>
  <body>
    <header class="header">
      <div class="container">
        <div class="logo-group">
          <a class="logo" href="/ui">ScaleODM UI</a>
          <span class="version">v{{ .Version }}</span>
        </div>
        <span class="badge">{{ if .ReadOnly }}Read-only{{ else }}Writable{{ end }}</span>
      </div>
    </header>
    <main class="container">
      <div class="warning">{{ .BannerText }}</div>
{{ end }}

{{ define "layout.pagination" }}
  <nav class="pagination" aria-label="Task pages">
    {{ if .HasPrev }}
    <a class="page-link" href="/ui{{ .PrevQuery }}" rel="prev">&larr; Previous</a>
    {{ else }}
    <span class="page-link disabled">&larr; Previous</span>
    {{ end }}
    <span class="page-current">Page {{ .Page }}</span>
    {{ if .HasNext }}
    <a class="page-link" href="/ui{{ .NextQuery }}" rel="next">Next &rarr;</a>
    {{ else }}
    <span class="page-link disabled">Next &rarr;</span>
    {{ end }}
  </nav>
{{ end }}

{{ define "layout.end" }}
    </main>
    <script src="/ui/static/ui.js" defer></script>
  </body>
</html>
{{ end }}
